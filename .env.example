# Auth
DATORYX_JWT_SECRET=change-me-to-a-long-random-string
DATORYX_JWT_TTL=604800

# LLM providers — DEFAULT provider priority (what answers a call with no
# explicit provider=):
#   1. Any cloud key you set below (groq > openai > anthropic > gemini,
#      or whichever you set as llm.default_provider in config) — a
#      configured key is a deliberate choice and always wins the default.
#   2. local — a llama.cpp GGUF file, if DATORYX_LOCAL_MODEL_PATH is set
#      or one exists under models/local/.
#   3. native — DAXRO 1.0, your own from-scratch trained checkpoint at
#      backend/models/native/checkpoint/model.pt, if present.
#   4. If nothing is registered at all, the app still runs and returns a
#      clearly-labeled simulated response instead of crashing.
#
# All registered providers (including local/native) remain reachable as
# automatic fallbacks if the default provider's call fails, and can always
# be called explicitly via provider="native" / provider="local" regardless
# of which one is the default — so setting a cloud key here does NOT
# disable DAXRO 1.0, it just means DAXRO 1.0 isn't used unless you ask
# for it by name or every cloud provider fails.
#
# GROQ_API_KEY also gets you Llama models (Groq hosts Meta's Llama 3.x
# family) - so one Groq key covers both "Groq" and "Llama" access; there's
# no separate literal "Llama API" needed unless you want to run a Llama
# GGUF file locally via LocalLlamaProvider instead (see README's
# "Adding more LLM providers" section).
GROQ_API_KEY=
GROK_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# DAXRO fine-tuned model, hosted remotely on a GPU (e.g. Modal - see
# daxro_modal_deploy/app.py). This is how the DAXRO fine-tuned model
# actually works on a CPU-only host like Render: the main app makes an
# HTTP call here instead of loading the model in-process (which needs a
# local CUDA GPU it doesn't have). Leave blank if you're not using this.
DAXRO_REMOTE_URL=
DAXRO_REMOTE_TOKEN=

# Optional - enables real web-grounded /research (Deep Research). Without
# this, /research still works but falls back to LLM-reasoning only (the
# response clearly labels which mode was used). Tavily has a free tier.
TAVILY_API_KEY=
